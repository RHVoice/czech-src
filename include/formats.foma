# For number:
define SpellDigit 
%0:nula | 
1:jedna | 
2:dva | 
3:tři | 
4:čtyři | 
5:pět | 
6:šest | 
7:sedum | 
8:osum | 
9:devět ; 

define Unit SpellDigit - [%0:[?+]] ; 
# Numbers and tokenization:
define dollar %$ ; 
define eur %€ ; 

define Digit SpellDigit.u ;
define NZDigit Digit - %0 ; 
define 2dFormat %0 Digit ; # 2digit format. 00, 01, 02... 09.
define DollarFormat %0|NZDigit Digit^<12 ; # Dollars must be less than 999999999999, unless you're a millionaire.
define CentFormat 2dFormat|NZDigit Digit ; # Cents must be less than 100, 1 to 99.
define UnformattedNumber %0 | [NZDigit Digit*] ; 
define Currency 
[[dollar|eur] DollarFormat %, CentFormat] ; 
define Number [UnformattedNumber | Currency] ; 
