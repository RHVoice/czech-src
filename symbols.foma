define Punctuation 
%,:čárka | 
%، : [arabská čárka] | 
%、 : [ideografická čárka] | 
%.:tečka | 
%?:otazník | 
%¿ : [obrácený otazník] |
%!:vykřičník | 
%¡ : [obrácený vykřičník] |
%::dvojtečka | 
%;:středník 
 | %؛ : [arabský středník]
 | %":uvozovky | 
%':apostrof | 
%(:[levá závorka] | 
%):[pravá závorka] | 
%-:minus | 
%[:[levá hranatá] | 
%]:[pravá hranatá] | 
%{:[levá složená] | 
%}:[pravá složená]
%〈 : [levá lomená závorka] |
%〉 : [pravá lomená závorka] 
%《 : [dvojitá levá lomená závorka] |
%》 : [dvojitá pravá lomená závorka] |
%「 : [levá rohová závorka] |
%」 : [pravá rohová závorka] |
%『 : [dvojitá levá rohová závorka] |
%』 : [dvojitá pravá rohová závorka] |
%【 : [levá plná lentikulární závorka] |
%】 : [pravá plná lentikulární závorka] |
%〔 : [levá asijská komentářová závorka] |
%〕 : [pravá asijská komentářová závorka] |
%〖 : [levá dutá lentikulární závorka] |
%〗 : [pravá dutá lentikulární závorka] 
 ; 

define Symbol 
%\:zpětné lomítko | 
%_:podtržítko | 
%`:přízvuk | 
%|:[svislá čára] | 
%* : [hvězdička] |
%… : [troitečka] |
%。 : [ideografická tečka] |
%‧ : [spojovací tečka] |
%“ : [levé uvozovky] |
%” : [pravé uvozovky] |
%„ : [uvozovky dole] |
%‘ : [jednoduchá uvozovka nahoře] |
%’ : [obrácená jednoduchá uvozovka nahoře] |
%‚ : [jednoduchá uvozovka dole] |
%« : [boční uvozovky mířící doleva] |
%» : [boční uvozovky mířící doprava] |
%‐ : [spojovník] |
%– : [krátká pomlčka] |
%— : [dlouhá pomlčka] |
%­ : [měkká pomlčka] |
%¯ : [přílišný důraz] |
%¸ : [cedylla] |
%▪ : [černý čtverec] |
%◾ : [černý čtverec] |
%® : [registrovaný] |
%™ : [ochranná známka] |
%© : [značka autorských práv] |
%~:vlnka ; 

